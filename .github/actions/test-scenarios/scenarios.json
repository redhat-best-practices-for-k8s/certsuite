[
  {
    "name": "TLS version range (non-compliant with Intermediate)",
    "description": "Deploys two nginx servers that each reject part of the Intermediate profile's required version range: one accepts only TLS 1.3 (rejecting TLS 1.2) and one accepts only TLS 1.2 (rejecting TLS 1.3). The Intermediate profile requires every version from TLS 1.2 through TLS 1.3, so both are non-compliant. One run covers both the below-minimum and the above-minimum version checks.",
    "path": "networking/tls-minimum-version",
    "manifest": "tls-noncompliant.yaml",
    "tests": {
      "networking-tls-minimum-version": {
        "expected_result": "failed",
        "min_noncompliant": 2,
        "noncompliant_contains": "-only"
      }
    },
    "output_dir": "tls-noncompliant-results"
  },
  {
    "name": "TLS version range (compliant with Intermediate profile)",
    "description": "Deploys one nginx server accepting both TLS 1.2 and TLS 1.3 with only Intermediate-profile ciphers, and one plain HTTP server with no TLS configured. On non-OpenShift clusters the test defaults to the Intermediate profile (min TLS 1.2): the TLS server meets the version and cipher requirements, and the plain HTTP service is reported as informational rather than as a failure.",
    "path": "networking/tls-minimum-version",
    "manifest": "tls-compliant.yaml",
    "tests": {
      "networking-tls-minimum-version": {
        "expected_result": "passed",
        "min_compliant": 1,
        "compliant_contains": "tls12-allowed"
      }
    },
    "output_dir": "tls-compliant-results"
  },
  {
    "name": "Unsecured container ports across nodes (plaintext + undeclared)",
    "description": "Deploys two plaintext HTTP workloads, two replicas each, with required hostname anti-affinity so every pair lands on different nodes. One declares its listening port, the other listens on 8080 without declaring it. One run covers both expectations: networking-unsecured-container-ports must fail every replica as plaintext (a single failure with the other pod unreachable is the cross-node openssl flake this guards against), and networking-undeclared-container-ports-usage must pass the declaring workload while failing the undeclared one.",
    "path": "networking/unsecured-container-ports",
    "manifest": "plaintext-spread.yaml",
    "tests": {
      "networking-unsecured-container-ports": {
        "expected_result": "failed",
        "min_noncompliant": 4,
        "noncompliant_contains": "spread"
      },
      "networking-undeclared-container-ports-usage": {
        "expected_result": "failed",
        "min_compliant": 1,
        "compliant_contains": "plain-http-spread",
        "noncompliant_contains": "undeclared-http-spread"
      }
    },
    "output_dir": "plaintext-spread-results"
  },
  {
    "name": "Secured container ports across nodes (compliant)",
    "description": "Deploys two TLS HTTP pods with required hostname anti-affinity so they land on different nodes. networking-unsecured-container-ports must pass, and both pods must be classified as using TLS. A pass with one pod marked unreachable is the cross-node openssl flake this scenario guards against.",
    "label_filter": "networking-unsecured-container-ports",
